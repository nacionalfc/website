---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main id="main-content" class="page-main" tabindex="-1">
		<section class="welcome-panel" aria-labelledby="page-title">
			<p class="eyebrow">Site em desenvolvimento</p>
			<h1 id="page-title">Nacional Futebol Clube</h1>
			<p class="welcome-panel__description">
				Conteúdo institucional aprovado será incluído nesta página.
			</p>
		</section>
	</main>
</Layout>

<style>
	.page-main {
		width: min(100% - 2rem, var(--content-width));
		margin-inline: auto;
		padding-block: clamp(3rem, 10vw, 8rem);
	}

	.welcome-panel {
		max-width: 52rem;
		padding: clamp(1.5rem, 5vw, 3.5rem);
		border-radius: var(--radius-large);
		background: var(--color-brand-blue);
		color: var(--color-on-brand);
	}

	.eyebrow {
		margin: 0 0 1rem;
		color: var(--color-brand-tint);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 14ch;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2.25rem, 7vw, 4.5rem);
		line-height: 1.04;
		letter-spacing: -0.04em;
	}

	.welcome-panel__description {
		max-width: 48ch;
		margin: 1.5rem 0 0;
		color: var(--color-brand-tint);
		font-size: clamp(1rem, 2vw, 1.125rem);
		line-height: 1.6;
	}
</style>
