---
import HomeHero from '../components/home/HomeHero.astro';
import NewsSection from '../components/home/NewsSection.astro';
import Layout from '../layouts/Layout.astro';
import { getVisibleNews, getVisiblePages } from '../lib/editorial';
import '../styles/home.css';
import '../styles/editorial.css';
import '../styles/news.css';

const [news, pages] = await Promise.all([getVisibleNews(), getVisiblePages()]);
const [featuredArticle] = news;
const recentArticles = news.slice(1, 4);
---

<Layout description="Notícias e páginas do Nacional Futebol Clube, de Manaus, Amazonas.">
	<main id="main-content" class="page-main" tabindex="-1">
		<HomeHero featuredArticle={featuredArticle} />
		<NewsSection articles={recentArticles} />

	</main>
</Layout>
