---
import NewsCard from '../../components/NewsCard.astro';
import Layout from '../../layouts/Layout.astro';
import { getVisibleNews } from '../../lib/editorial';
import '../../styles/editorial.css';
import '../../styles/news.css';

const articles = await getVisibleNews();
const [featuredArticle, ...otherArticles] = articles;
---

<Layout title="Notícias | Nacional Futebol Clube" description="Notícias publicadas pelo Nacional Futebol Clube.">
	<main id="main-content" class="page-main" tabindex="-1">
		<header class="page-heading">
			<h1>Notícias</h1>
			<p>Publicações do Nacional Futebol Clube.</p>
		</header>

		{featuredArticle ? (
			<div class="news-listing">
				<NewsCard article={featuredArticle} featured />
				{otherArticles.length > 0 && (
					<div class="news-list">
						{otherArticles.map((article) => <NewsCard article={article} />)}
					</div>
				)}
			</div>
		) : (
			<p class="empty-state">Ainda não há notícias publicadas.</p>
		)}
	</main>
</Layout>
