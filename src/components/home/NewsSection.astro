---
import type { CollectionEntry } from 'astro:content';
import NewsCard from '../NewsCard.astro';

interface Props {
	articles: CollectionEntry<'news'>[];
}

const { articles } = Astro.props;
---

{articles.length > 0 && (
	<section class="home-section" aria-labelledby="latest-news-title">
		<div class="home-section__heading">
			<h2 id="latest-news-title">Mais notícias</h2>
			<a href="/noticias/">Todas as notícias</a>
		</div>
		<div class="news-list">
			{articles.map((article) => <NewsCard article={article} />)}
		</div>
	</section>
)}
